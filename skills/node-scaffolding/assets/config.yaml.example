# Base configuration — safe to commit, no secrets.
# Copy to config.yaml and adjust for your environment.

env: development
log:
  level: info
  type: pretty
# port is only needed when the HTTP server is enabled (withHttp=yes).
port: 3000
# openapi block is only needed when withOpenApi=yes.
openapi:
  title: My API
  version: 1.0.0
  description: ""
